def ip_locale():
    """Adresse IP de la machine sur le réseau local."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))  # aucun paquet n'est envoyé
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


def qr_terminal(donnees):
    """Dessine un code QR dans le terminal. Renvoie False si aucun outil n'est disponible."""
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "ansiutf8", "-m", "2", donnees])
        return True
    try:
        import qrcode
    except ImportError:
        print("  (Pour voir le code QR ici : sudo apt install qrencode)")
        return False
    qr = qrcode.QRCode(border=2)
    qr.add_data(donnees)
    qr.print_ascii(invert=True)
    return True


def qr_fichier(donnees, chemin):
    """Enregistre le code QR en PNG ou SVG."""
    svg = chemin.lower().endswith(".svg")
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "SVG" if svg else "PNG", "-s", "10", "-m", "2",
                        "-o", chemin, donnees], check=True)
        return
    try:
        import qrcode
        if svg:
            import qrcode.image.svg
            qrcode.make(donnees, image_factory=qrcode.image.svg.SvgPathImage).save(chemin)
        else:
            qrcode.make(donnees, box_size=10, border=2).save(chemin)
    except ImportError:
        sys.exit("miroir: installez qrencode (sudo apt install qrencode) ou pip install 'qrcode[pil]'")


def afficher_qr(url):
    print()
    qr_terminal(url)
    print(f"\n  Scannez le code QR ou ouvrez : \033[1m{url}\033[0m")
    print("  Ctrl+C pour arrêter.\n")


def taille(o):
    for unite in ("o", "Ko", "Mo", "Go"):
        if o < 1024 or unite == "Go":
            return f"{o:.0f} {unite}" if unite == "o" else f"{o:.1f} {unite}"
        o /= 1024


def chemin_protege(gestionnaire, jeton):
    """Partie de l'adresse après /<jeton>/, ou None si le jeton est absent ou faux."""
    morceaux = urllib.parse.urlparse(gestionnaire.path).path.split("/", 2)
    if len(morceaux) < 2 or not hmac.compare_digest(morceaux[1].encode(), jeton.encode()):
        return None
    return morceaux[2] if len(morceaux) > 2 else ""


def lancer(gestionnaire, port, chemin=""):
    serveur = ThreadingHTTPServer(("0.0.0.0", port), gestionnaire)
    url = f"http://{ip_locale()}:{serveur.server_address[1]}/{chemin}"
    afficher_qr(url)
    try:
        serveur.serve_forever()
    except KeyboardInterrupt:
        print("\nArrêté.")
    return url


def creer_fichier_libre(dossier, nom):
    """Crée un fichier au nom sûr (sans chemin) qui n'écrase rien dans le dossier.

    La création exclusive (O_EXCL) réserve le nom : deux envois simultanés du même
    fichier obtiennent chacun le leur. Renvoie (chemin, fichier ouvert en écriture).
    """
    nom = os.path.basename(nom.replace("\\", "/")).strip().lstrip(".") or "fichier"
    base, ext = os.path.splitext(nom)
    chemin, n = os.path.join(dossier, nom), 1
    while True:
        try:
            fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            return chemin, os.fdopen(fd, "wb")
        except FileExistsError:
            chemin = os.path.join(dossier, f"{base} ({n}){ext}")
            n += 1


def recevoir_corps(gestionnaire, dossier, nom):
    """Écrit le corps de la requête dans le dossier. Renvoie le chemin, ou None si incomplet."""
    reste = int(gestionnaire.headers.get("Content-Length", 0))
    chemin, sortie = creer_fichier_libre(dossier, nom)
    with sortie:
        while reste > 0:
            bloc = gestionnaire.rfile.read(min(reste, 1 << 20))
            if not bloc:
                break
            sortie.write(bloc)
            reste -= len(bloc)
    if reste:
        os.remove(chemin)
        return None
    return chemin


def executer(cmd, entree=None, sortie=False):
    """Lance une commande système, sans jamais lever d'exception."""
    try:
        r = subprocess.run(cmd, input=entree, timeout=5,
                           stdout=subprocess.PIPE if sortie else subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        return r.stdout if sortie else r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return b"" if sortie else False


def wayland():
    return bool(os.environ.get("WAYLAND_DISPLAY")) or os.environ.get("XDG_SESSION_TYPE") == "wayland"


# ---------- envoyer : Linux -> téléphone ----------

def cmd_envoyer(args):
    fichiers = []
    for chemin in args.fichiers:
        if os.path.isdir(chemin):
            for racine, _, noms in os.walk(chemin):
                fichiers += [os.path.join(racine, n) for n in sorted(noms)]
        elif os.path.isfile(chemin):
            fichiers.append(chemin)
        else:
            sys.exit(f"miroir: fichier introuvable : {chemin}")
    if not fichiers:
        sys.exit("miroir: aucun fichier à envoyer")

    # Clé secrète dans l'adresse : seul celui qui a scanné le QR peut télécharger.
    jeton = secrets.token_urlsafe(16)

    class Envoi(SimpleHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            chemin = chemin_protege(self, jeton)
            if chemin is None:
                return self.send_error(404)
            if chemin in ("", "index.html"):
                liens = "".join(
                    f'<a href="f/{i}">⬇ {html.escape(os.path.basename(f))} '
                    f"<small>({taille(os.path.getsize(f))})</small></a>"
                    for i, f in enumerate(fichiers))
                corps = f"<!doctype html><meta charset=utf-8><title>Miroir</title>{STYLE}" \
                        f"<h1>Miroir — fichiers partagés</h1>{liens}"
                self.envoyer_texte(corps)
            elif chemin.startswith("f/"):
                try:
                    f = fichiers[int(chemin[2:])]
                except (ValueError, IndexError):
                    return self.send_error(404)
                envoyer_fichier(self, f)
                print(f"  ✓ téléchargé par {self.client_address[0]} : {os.path.basename(f)}")
            else:
                self.send_error(404)

        def envoyer_texte(self, corps):
            donnees = corps.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(donnees)))
            self.end_headers()
            self.wfile.write(donnees)

    print(f"Partage de {len(fichiers)} fichier(s).")
    lancer(Envoi, args.port, jeton + "/")


def envoyer_fichier(gestionnaire, chemin):
    nom = os.path.basename(chemin)
    gestionnaire.send_response(200)
    gestionnaire.send_header("Content-Type", mimetypes.guess_type(nom)[0] or "application/octet-stream")
    gestionnaire.send_header("Content-Length", str(os.path.getsize(chemin)))
    gestionnaire.send_header("Content-Disposition",
                             "attachment; filename*=UTF-8''" + urllib.parse.quote(nom))
    gestionnaire.end_headers()
    with open(chemin, "rb") as source:
        shutil.copyfileobj(source, gestionnaire.wfile)


