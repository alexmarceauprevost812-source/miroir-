def gestionnaire_hub(hub):
    class Gestionnaire(BaseHTTPRequestHandler):
        server_version = "miroir"

        def log_message(self, *a):
            pass

        # --- réponses ---
        def repondre(self, code, corps=b"", type_="text/plain; charset=utf-8", entetes=()):
            self.send_response(code)
            self.send_header("Content-Type", type_)
            self.send_header("Content-Length", str(len(corps)))
            self.send_header("Cache-Control", "no-store")
            for cle, valeur in entetes:
                self.send_header(cle, valeur)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(corps)

        def json(self, objet, code=200):
            self.repondre(code, json.dumps(objet).encode(), "application/json")

        def corps(self, maximum=1 << 20):
            n = int(self.headers.get("Content-Length", 0))
            if n > maximum:
                raise ValueError("trop grand")
            return self.rfile.read(n)

        def corps_json(self):
            try:
                return json.loads(self.corps() or b"{}")
            except (ValueError, UnicodeDecodeError):
                return {}

        # --- connexion par QR : le jeton du QR devient un cookie ---
        def jeton_requete(self):
            auth = self.headers.get("Authorization", "")
            if auth.startswith("Bearer "):
                return auth[7:].strip(), False
            requete = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if "t" in requete:
                return requete["t"][0], False
            try:
                c = cookies.SimpleCookie(self.headers.get("Cookie", "")).get("miroir")
            except cookies.CookieError:
                c = None
            return (c.value if c else ""), True

        def autorise(self):
            jeton, par_cookie = self.jeton_requete()
            if not jeton or not hmac.compare_digest(jeton.encode(), hub.jeton.encode()):
                return False
            # Protection CSRF : les écritures faites avec le cookie doivent venir de la page.
            if par_cookie and self.command not in ("GET", "HEAD"):
                return self.headers.get("X-Miroir") == "1"
            return True

        def local(self):
            return self.client_address[0] in ("127.0.0.1", "::1")

        # --- routes ---
        def do_HEAD(self):
            self.do_GET()

        def do_GET(self):
            url = urllib.parse.urlparse(self.path)
            chemin = url.path
            if chemin.startswith("/pc/") and chemin[4:] in FICHIERS_STATIQUES:
                with open(os.path.join(DOSSIER_PAGES, chemin[4:]), "rb") as f:
                    return self.repondre(200, f.read(), FICHIERS_STATIQUES[chemin[4:]])
            if chemin == "/miroir-ca.crt" and hub.ca_der:
                return self.repondre(200, hub.ca_der, "application/x-x509-ca-cert",
                                     [("Content-Disposition", 'attachment; filename="miroir-ca.crt"')])
            if chemin in ("/webcam.mjpg", "/webcam") and (self.local() or self.autorise()):
                return self.flux_webcam() if chemin == "/webcam.mjpg" else self.repondre(
                    200, b"<!doctype html><title>Miroir webcam</title><body style='margin:0;background:#000'>"
                         b"<img src='/webcam.mjpg' style='width:100vw;height:100vh;object-fit:contain'>",
                    "text/html; charset=utf-8")
            if not self.autorise():
                if chemin == "/":
                    return self.repondre(401, PAGE_REFUS.encode(), "text/html; charset=utf-8")
                return self.json({"erreur": "non autorisé"}, 401)
            if chemin == "/":
                with open(os.path.join(DOSSIER_PAGES, "telephone.html"), "rb") as f:
                    page = f.read()
                cookie = f"miroir={hub.jeton}; Path=/; Max-Age=2592000; HttpOnly; SameSite=Lax"
                if hub.https:
                    cookie += "; Secure"
                return self.repondre(200, page, "text/html; charset=utf-8", [("Set-Cookie", cookie)])
            if chemin == "/api/etat":
                return self.json(self.etat())
            if chemin == "/api/fichiers":
                return self.json(lister_partages(hub.racines))
            if chemin == "/api/fichier":
                q = urllib.parse.parse_qs(url.query)
                fichier = resoudre_partage(hub.racines, q.get("r", [""])[0], q.get("p", [""])[0])
                if not fichier:
                    return self.json({"erreur": "introuvable"}, 404)
                envoyer_fichier(self, fichier)
                print(f"  ⬇ téléchargé par le téléphone : {os.path.basename(fichier)}")
                return
            if chemin == "/api/presse-papiers":
                return self.json({"texte": hub.presse_papiers.lire()})
            self.json({"erreur": "introuvable"}, 404)

        def do_POST(self):
            chemin = urllib.parse.urlparse(self.path).path
            if not self.autorise():
                return self.json({"erreur": "non autorisé"}, 401)
            try:
                if chemin == "/api/webcam":
                    hub.webcam.recevoir(self.corps(10 << 20))
                    return self.json({"ok": True})
                if chemin == "/api/notification":
                    return self.notification()
                donnees = self.corps_json()
            except ValueError:
                return self.json({"erreur": "requête trop grande"}, 413)
            if chemin == "/api/presse-papiers":
                texte = str(donnees.get("texte", ""))
                if not hub.presse_papiers.ecrire(texte):
                    print("  ✗ presse-papiers du PC inaccessible")
                    return self.json({"ok": False, "erreur": "Presse-papiers du PC inaccessible"}, 502)
                print(f"  📋 copié sur le PC : {texte[:80]!r}")
                return self.json({"ok": True})
            if chemin == "/api/texte":
                return self.texte(donnees)
            if chemin == "/api/controle":
                return self.json({"ok": self.controle(donnees)})
            self.json({"erreur": "introuvable"}, 404)

        def do_PUT(self):
            url = urllib.parse.urlparse(self.path)
            if not self.autorise():
                return self.json({"erreur": "non autorisé"}, 401)
            if url.path != "/api/envoi":
                return self.json({"erreur": "introuvable"}, 404)
            os.makedirs(hub.dossier, exist_ok=True)
            nom = urllib.parse.parse_qs(url.query).get("nom", ["fichier"])[0]
            chemin = recevoir_corps(self, hub.dossier, nom)
            if not chemin:
                return self.json({"erreur": "envoi incomplet"}, 400)
            print(f"  ⬆ reçu : {chemin} ({taille(os.path.getsize(chemin))})")
            hub.notifier("Fichier reçu", os.path.basename(chemin))
            self.json({"ok": True, "nom": os.path.basename(chemin)})

        # --- fonctions ---
        def etat(self):
            hote = self.headers.get("Host", f"{ip_locale()}")
            schema = "https" if hub.https else "http"
            return {
                "machine": socket.gethostname(),
                "dossier": hub.dossier,
                "presse_papiers": hub.presse_papiers.outil,
                "controle": hub.controle.outil,
                "volume": hub.controle.volume,
                "media": hub.controle.media,
                "notifications": bool(hub.notify),
                "https": hub.https,
                "webcam_v4l2": hub.webcam.peripherique,
                "url_webcam": f"{schema}://{hote}/webcam",
                "url_notification": f"{schema}://{hote}/api/notification?t={hub.jeton}",
            }

        def texte(self, donnees):
            texte = str(donnees.get("texte", "")).strip()
            action = donnees.get("action")
            if not texte:
                return self.json({"ok": False, "erreur": "texte vide"}, 400)
            if action == "ouvrir":
                lien = urllib.parse.urlparse(texte)
                if lien.scheme not in ("http", "https") or not lien.netloc:
                    return self.json({"ok": False, "erreur": "ce n'est pas un lien web"}, 400)
                print(f"  🔗 ouverture : {texte}")
                try:
                    subprocess.Popen(["xdg-open", texte], stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    return self.json({"ok": False, "erreur": "xdg-open introuvable"}, 500)
                return self.json({"ok": True})
            if action == "notifier":
                hub.notifier("Texte du téléphone", texte)
                return self.json({"ok": True})
            return self.json({"ok": False, "erreur": "action inconnue"}, 400)

        def notification(self):
            brut = self.corps()
            if "json" in self.headers.get("Content-Type", ""):
                try:
                    d = json.loads(brut or b"{}")
                except ValueError:
                    d = None
                if not isinstance(d, dict):
                    return self.json({"ok": False, "erreur": "JSON attendu : un objet {titre, texte, appli}"}, 400)
            else:
                d = {"texte": brut.decode("utf-8", "replace")}
            titre = str(d.get("titre") or d.get("title") or "Téléphone")
            texte = str(d.get("texte") or d.get("text") or d.get("message") or "")
            appli = str(d.get("appli") or d.get("app") or "Téléphone")
            hub.notifier(titre, texte, appli)
            self.json({"ok": True})

        def controle(self, d):
            c = hub.controle
            action, valeur = d.get("action"), d.get("valeur")
            try:
                if action == "deplacer":
                    dx = max(-2000, min(2000, int(d.get("dx", 0))))
                    dy = max(-2000, min(2000, int(d.get("dy", 0))))
                    return c.deplacer(dx, dy)
                if action == "defiler":
                    return c.defiler(max(-50, min(50, int(d.get("n", 0)))))
            except (TypeError, ValueError):
                return False
            if action == "clic" and valeur in c.BOUTONS:
                return c.clic(valeur)
            if action == "touche" and valeur in c.TOUCHES:
                return c.touche(valeur)
            if action == "taper" and isinstance(valeur, str) and 0 < len(valeur) <= 2000:
                return c.taper(valeur)
            if action == "volume" and valeur in ("plus", "moins", "muet"):
                return c.regler_volume(valeur)
            if action == "media" and valeur in c.MEDIAS:
                return c.commande_media(valeur)
            return False

        def flux_webcam(self):
            self.send_response(200)
            self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=cadre")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            numero = -1
            try:
                while True:
                    image, numero = hub.webcam.attendre(numero)
                    if image is None:
                        continue
                    self.wfile.write(b"--cadre\r\nContent-Type: image/jpeg\r\nContent-Length: "
                                     + str(len(image)).encode() + b"\r\n\r\n" + image + b"\r\n")
            except (BrokenPipeError, ConnectionResetError, ssl.SSLError):
                pass

    return Gestionnaire


class ServeurHub(ThreadingHTTPServer):
    def handle_error(self, requete, adresse):
        # Les téléphones qui refusent le certificat ou coupent la connexion : rien d'anormal.
        if isinstance(sys.exc_info()[1], (ssl.SSLError, ConnectionError, TimeoutError)):
            return
        super().handle_error(requete, adresse)


