def cmd_tv(args):
    ca = {}

    class App(BaseHTTPRequestHandler):
        """Ne sert que les fichiers de l'application TV (jamais .git ni le reste du dossier)."""

        def log_message(self, *a):
            pass

        def do_HEAD(self):
            self.do_GET()

        def do_GET(self):
            chemin = urllib.parse.urlparse(self.path).path.lstrip("/") or "index.html"
            if chemin == "miroir-ca.crt" and ca.get("der"):
                corps, type_ = ca["der"], "application/x-x509-ca-cert"
            elif chemin in FICHIERS_TV:
                with open(os.path.join(DOSSIER_APP, chemin), "rb") as f:
                    corps, type_ = f.read(), FICHIERS_TV[chemin]
            else:
                return self.send_error(404)
            self.send_response(200)
            self.send_header("Content-Type", type_)
            self.send_header("Content-Length", str(len(corps)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(corps)

    serveur = ServeurHub(("0.0.0.0", args.port), App)
    schema = "https" if args.https else "http"
    url = f"{schema}://{ip_locale()}:{serveur.server_address[1]}/index.html"
    if args.signal:
        url += "?signal=" + urllib.parse.quote(args.signal, safe="")
    print("Écran TV de Miroir. Ouvrez cette adresse dans le navigateur de la TV :")
    if args.https:
        ca["der"] = activer_https(serveur, ip_locale())
    else:
        print("  \033[33m✗\033[0m En HTTP, le téléphone ne peut envoyer que des fichiers : la caméra et le\n"
              "    partage d'écran exigent HTTPS (« miroir tv --https »).")
    afficher_qr(url)
    if not args.sans_navigateur:
        webbrowser.open(url)
    try:
        serveur.serve_forever()
    except KeyboardInterrupt:
        print("\nArrêté.")


def options_wifi(p):
    p.add_argument("--ssid", help="nom du réseau (par défaut : le Wi-Fi actuel)")
    p.add_argument("--mdp", help="mot de passe (demandé s'il manque)")
    p.add_argument("--securite", default="WPA", choices=["WPA", "SAE", "WEP", "aucune"])
    p.add_argument("--cache", action="store_true", help="réseau masqué")
    p.add_argument("-o", "--sortie", help="enregistrer en image .png ou .svg")
    p.set_defaults(fn=cmd_wifi)


def options_hub(p, https=False):
    p.add_argument("fichiers", nargs="*", help="fichiers ou dossiers à proposer au téléphone")
    p.add_argument("-d", "--dossier", default=RECEPTION_DEFAUT, help="où enregistrer les fichiers reçus")
    p.add_argument("-p", "--port", type=int, default=8443 if https else 8080)
    p.add_argument("--v4l2", help="webcam virtuelle v4l2loopback (ex. /dev/video10)")
    p.add_argument("--nouveau-jeton", action="store_true",
                   help="change le jeton de connexion (déconnecte les anciens téléphones)")


def main():
    p = argparse.ArgumentParser(prog="miroir", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sous = p.add_subparsers(dest="commande", required=True)

    h = sous.add_parser("hub", help="tout-en-un : fichiers, presse-papiers, télécommande, notifications")
    options_hub(h)
    h.add_argument("--https", action="store_true", help="HTTPS (webcam, presse-papiers du téléphone)")
    h.set_defaults(fn=cmd_hub)

    w = sous.add_parser("webcam", help="la caméra du téléphone devient la webcam du PC")
    options_hub(w, https=True)
    w.set_defaults(fn=cmd_webcam)

    e = sous.add_parser("envoyer", help="envoyer des fichiers de Linux vers le téléphone")
    e.add_argument("fichiers", nargs="+", help="fichiers ou dossiers")
    e.add_argument("-p", "--port", type=int, default=8080)
    e.set_defaults(fn=cmd_envoyer)

    r = sous.add_parser("recevoir", help="recevoir des fichiers du téléphone sur Linux")
    r.add_argument("-d", "--dossier", default=RECEPTION_DEFAUT)
    r.add_argument("-p", "--port", type=int, default=8080)
    r.set_defaults(fn=cmd_recevoir)

    options_wifi(sous.add_parser("wifi", help="QR pour connecter un invité au Wi-Fi"))

    q = sous.add_parser("qr", help="générer un code QR (lien, texte, contact, wifi)")
    qs = q.add_subparsers(dest="type", required=True)
    ql = qs.add_parser("lien", help="ouvre une adresse web")
    ql.add_argument("valeur")
    qt = qs.add_parser("texte", help="texte libre (ou lu sur l'entrée standard)")
    qt.add_argument("valeur", nargs="*")
    qc = qs.add_parser("contact", help="carte de visite (vCard)")
    qc.add_argument("--nom", required=True, help="Prénom Nom")
    qc.add_argument("--tel", action="append", help="téléphone (répétable)")
    qc.add_argument("--email", action="append", help="courriel (répétable)")
    qc.add_argument("--org", help="entreprise")
    qc.add_argument("--poste", help="fonction")
    qc.add_argument("--adresse")
    qc.add_argument("--site")
    options_wifi(qs.add_parser("wifi", help="réseau Wi-Fi"))
    for sp in (ql, qt, qc):
        sp.add_argument("-o", "--sortie", help="enregistrer en image .png ou .svg")
    q.set_defaults(fn=cmd_qr)

    t = sous.add_parser("tv", help="ouvrir l'écran TV de Miroir depuis ce PC")
    t.add_argument("-p", "--port", type=int, default=8080)
    t.add_argument("--signal", help="serveur PeerJS perso (ex. http://192.168.1.10:9000/miroir)")
    t.add_argument("--sans-navigateur", action="store_true", help="ne pas ouvrir le navigateur")
    t.add_argument("--https", action="store_true", help="HTTPS (caméra et partage d'écran du téléphone)")
    t.set_defaults(fn=cmd_tv)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
