class PressePapiers:
    def __init__(self):
        if wayland() and shutil.which("wl-copy") and shutil.which("wl-paste"):
            self.outil, self.ecrire_cmd, self.lire_cmd = "wl-clipboard", ["wl-copy"], ["wl-paste", "-n"]
        elif shutil.which("xclip"):
            self.outil = "xclip"
            self.ecrire_cmd = ["xclip", "-selection", "clipboard", "-in"]
            self.lire_cmd = ["xclip", "-selection", "clipboard", "-out"]
        elif shutil.which("xsel"):
            self.outil, self.ecrire_cmd, self.lire_cmd = "xsel", ["xsel", "-b", "-i"], ["xsel", "-b", "-o"]
        else:
            self.outil = None

    def lire(self):
        return executer(self.lire_cmd, sortie=True).decode("utf-8", "replace") if self.outil else ""

    def ecrire(self, texte):
        return bool(self.outil) and executer(self.ecrire_cmd, entree=texte.encode())


class Controle:
    """Souris, clavier, volume et médias avec xdotool (X11) ou ydotool (Wayland)."""

    # nom -> (nom xdotool, code clavier Linux pour ydotool)
    TOUCHES = {
        "gauche": ("Left", 105), "droite": ("Right", 106), "haut": ("Up", 103), "bas": ("Down", 108),
        "entree": ("Return", 28), "retour": ("BackSpace", 14), "echap": ("Escape", 1),
        "tab": ("Tab", 15), "espace": ("space", 57), "pageprec": ("Page_Up", 104),
        "pagesuiv": ("Page_Down", 109), "debut": ("Home", 102), "fin": ("End", 107),
        "f5": ("F5", 63), "f11": ("F11", 87), "noir": ("b", 48),
    }
    MEDIAS = {"lecture": ("play-pause", "XF86AudioPlay", 164),
              "suivant": ("next", "XF86AudioNext", 163),
              "precedent": ("previous", "XF86AudioPrev", 165)}
    BOUTONS = {"gauche": ("1", "0xC0"), "droit": ("3", "0xC1"), "milieu": ("2", "0xC2")}

    def __init__(self):
        if shutil.which("ydotool") and (wayland() or not shutil.which("xdotool")):
            self.outil = "ydotool"
        elif shutil.which("xdotool"):
            self.outil = "xdotool"
        else:
            self.outil = None
        self.volume = next((o for o in ("wpctl", "pactl", "amixer") if shutil.which(o)), None)
        self.media = "playerctl" if shutil.which("playerctl") else self.outil

    def deplacer(self, dx, dy):
        if self.outil == "xdotool":
            return executer(["xdotool", "mousemove_relative", "--", str(dx), str(dy)])
        if self.outil == "ydotool":
            return executer(["ydotool", "mousemove", "-x", str(dx), "-y", str(dy)])
        return False

    def clic(self, bouton):
        x, y = self.BOUTONS[bouton]
        if self.outil == "xdotool":
            return executer(["xdotool", "click", x])
        if self.outil == "ydotool":
            return executer(["ydotool", "click", y])
        return False

    def defiler(self, n):
        """n > 0 : vers le bas."""
        if self.outil == "xdotool":
            return executer(["xdotool", "click", "--repeat", str(abs(n)), "5" if n > 0 else "4"])
        if self.outil == "ydotool":
            return executer(["ydotool", "mousemove", "-w", "-x", "0", "-y", str(-n)])
        return False

    def taper(self, texte):
        if self.outil == "xdotool":
            return executer(["xdotool", "type", "--delay", "5", "--", texte])
        if self.outil == "ydotool":
            return executer(["ydotool", "type", "--", texte])
        return False

    def touche(self, nom):
        x, code = self.TOUCHES[nom]
        if self.outil == "xdotool":
            return executer(["xdotool", "key", x])
        if self.outil == "ydotool":
            return executer(["ydotool", "key", f"{code}:1", f"{code}:0"])
        return False

    def regler_volume(self, sens):
        cmds = {
            "wpctl": {"plus": ["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", "5%+"],
                      "moins": ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"],
                      "muet": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]},
            "pactl": {"plus": ["pactl", "set-sink-volume", "@DEFAULT_SINK@", "+5%"],
                      "moins": ["pactl", "set-sink-volume", "@DEFAULT_SINK@", "-5%"],
                      "muet": ["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle"]},
            "amixer": {"plus": ["amixer", "-q", "set", "Master", "5%+"],
                       "moins": ["amixer", "-q", "set", "Master", "5%-"],
                       "muet": ["amixer", "-q", "set", "Master", "toggle"]},
        }
        return bool(self.volume) and executer(cmds[self.volume][sens])

    def commande_media(self, nom):
        pc, x, code = self.MEDIAS[nom]
        if self.media == "playerctl":
            return executer(["playerctl", pc])
        if self.media == "xdotool":
            return executer(["xdotool", "key", x])
        if self.media == "ydotool":
            return executer(["ydotool", "key", f"{code}:1", f"{code}:0"])
        return False


class Webcam:
    """Reçoit les images JPEG du téléphone : flux MJPEG + webcam virtuelle v4l2loopback."""

    def __init__(self, peripherique):
        self.peripherique = peripherique
        self.cond = threading.Condition()
        self.image, self.numero = None, 0
        self.verrou = threading.Lock()
        self.ffmpeg, self.dernier_lancement = None, 0.0

    def recevoir(self, jpeg):
        with self.cond:
            self.image, self.numero = jpeg, self.numero + 1
            self.cond.notify_all()
        if self.peripherique:
            self.vers_v4l2(jpeg)

    def vers_v4l2(self, jpeg):
        with self.verrou:
            if self.ffmpeg is None or self.ffmpeg.poll() is not None:
                if time.monotonic() - self.dernier_lancement < 2:
                    return
                self.dernier_lancement = time.monotonic()
                self.ffmpeg = subprocess.Popen(
                    ["ffmpeg", "-loglevel", "error", "-fflags", "nobuffer", "-f", "mjpeg", "-i", "-",
                     "-pix_fmt", "yuv420p", "-f", "v4l2", self.peripherique],
                    stdin=subprocess.PIPE)
                print(f"  📷 webcam virtuelle active : {self.peripherique}")
            try:
                self.ffmpeg.stdin.write(jpeg)
                self.ffmpeg.stdin.flush()
            except (BrokenPipeError, OSError):
                self.ffmpeg = None

    def attendre(self, apres):
        with self.cond:
            self.cond.wait_for(lambda: self.numero != apres, timeout=10)
            return self.image, self.numero


def peripherique_v4l2loopback():
    for chemin in sorted(glob.glob("/sys/devices/virtual/video4linux/video*")):
        return "/dev/" + os.path.basename(chemin)
    return None


def jeton_persistant(nouveau=False):
    """Jeton secret de connexion, gardé entre deux lancements (le QR reste valable)."""
    os.makedirs(CONFIG, mode=0o700, exist_ok=True)
    chemin = os.path.join(CONFIG, "jeton")
    if not nouveau and os.path.exists(chemin):
        with open(chemin) as f:
            jeton = f.read().strip()
        if jeton:
            return jeton
    jeton = secrets.token_urlsafe(18)
    fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(jeton)
    return jeton


def certificat(ip):
    """Certificat HTTPS (nécessaire pour la caméra du téléphone).

    Une autorité locale « Miroir » est créée une fois ; installée comme certificat de
    confiance sur le téléphone, elle supprime l'avertissement. Elle signe un certificat
    valable pour l'adresse IP du PC, refait si cette adresse change.
    Renvoie (certificat, clé, autorité).
    """
    if not shutil.which("openssl"):
        sys.exit("miroir: le HTTPS nécessite openssl (sudo apt install openssl)")
    os.makedirs(CONFIG, mode=0o700, exist_ok=True)
    ca, ca_cle = os.path.join(CONFIG, "ca.pem"), os.path.join(CONFIG, "ca-cle.pem")
    cert, cle = os.path.join(CONFIG, "cert.pem"), os.path.join(CONFIG, "cle.pem")
    marque = os.path.join(CONFIG, "cert-ip.txt")

    def openssl(*arguments):
        subprocess.run(["openssl", *arguments], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Verrou : deux commandes miroir lancées ensemble ne créent pas les certificats en même temps.
    with open(os.path.join(CONFIG, "cert.verrou"), "w") as verrou:
        fcntl.flock(verrou, fcntl.LOCK_EX)
        return creer_certificats(openssl, ip, ca, ca_cle, cert, cle, marque)


def creer_certificats(openssl, ip, ca, ca_cle, cert, cle, marque):
    def expire_bientot(certificat_pem):
        """Vrai si le certificat expire dans moins de 30 jours (ou est illisible)."""
        return subprocess.run(["openssl", "x509", "-checkend", str(30 * 86400), "-noout",
                               "-in", certificat_pem], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode != 0

    if not (os.path.exists(ca) and os.path.exists(ca_cle)) or expire_bientot(ca):
        if os.path.exists(ca):
            print("  L'autorité Miroir expire : une nouvelle est créée, réinstallez-la sur le téléphone.")
        openssl("req", "-utf8", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650",
                "-subj", f"/CN=Miroir {socket.gethostname()} (autorité locale)",
                "-addext", "basicConstraints=critical,CA:TRUE",
                "-addext", "keyUsage=critical,keyCertSign,cRLSign",
                "-keyout", ca_cle, "-out", ca)
        os.chmod(ca_cle, 0o600)
        if os.path.exists(marque):
            os.remove(marque)

    ip_certifiee = open(marque).read().strip() if os.path.exists(marque) else ""
    if ip_certifiee != ip or not (os.path.exists(cert) and os.path.exists(cle)) or expire_bientot(cert):
        demande, extensions = os.path.join(CONFIG, "cert.csr"), os.path.join(CONFIG, "cert.ext")
        with open(extensions, "w") as f:
            f.write(f"subjectAltName=IP:{ip},IP:127.0.0.1,DNS:localhost\n"
                    "basicConstraints=critical,CA:FALSE\n"
                    "keyUsage=critical,digitalSignature,keyEncipherment\n"
                    "extendedKeyUsage=serverAuth\n")
        openssl("req", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=miroir",
                "-keyout", cle, "-out", demande)
        # 825 jours : durée maximale acceptée par iOS pour un certificat de serveur.
        openssl("x509", "-req", "-in", demande, "-CA", ca, "-CAkey", ca_cle, "-CAcreateserial",
                "-days", "825", "-sha256", "-extfile", extensions, "-out", cert)
        os.chmod(cle, 0o600)
        os.remove(demande)
        os.remove(extensions)
        with open(marque, "w") as f:
            f.write(ip)
    return cert, cle, ca


def ca_der(ca):
    """L'autorité locale au format DER, que Android et iOS savent installer."""
    with open(ca) as f:
        return ssl.PEM_cert_to_DER_cert(f.read())


def activer_https(serveur, ip):
    """Passe le serveur en HTTPS et explique comment faire confiance au certificat."""
    cert, cle, ca = certificat(ip)
    contexte = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    contexte.load_cert_chain(cert, cle)
    serveur.socket = contexte.wrap_socket(serveur.socket, server_side=True,
                                          do_handshake_on_connect=False)
    der = ca_der(ca)
    empreinte = hashlib.sha256(der).hexdigest().upper()
    print(f"  Pour éviter l'avertissement HTTPS, installez une fois sur le téléphone l'autorité Miroir :\n"
          f"    https://{ip}:{serveur.server_address[1]}/miroir-ca.crt\n"
          f"    (empreinte SHA-256 {':'.join(empreinte[i:i + 2] for i in range(0, 16, 2))}…) — voir le README.")
    return der


def lister_partages(racines):
    fichiers = []
    for r, racine in enumerate(racines):
        if os.path.isfile(racine):
            fichiers.append({"r": r, "p": "", "nom": os.path.basename(racine),
                             "taille": os.path.getsize(racine)})
        elif os.path.isdir(racine):
            for dossier, sous, noms in os.walk(racine):
                sous[:] = sorted(d for d in sous if not d.startswith("."))
                for n in sorted(noms):
                    if n.startswith("."):
                        continue
                    chemin = os.path.join(dossier, n)
                    if resoudre_partage(racines, r, os.path.relpath(chemin, racine)):
                        fichiers.append({"r": r, "p": os.path.relpath(chemin, racine), "nom": n,
                                         "taille": os.path.getsize(chemin)})
    return fichiers


def resoudre_partage(racines, r, p):
    """Chemin réel d'un fichier partagé, en refusant toute sortie du dossier partagé."""
    try:
        racine = racines[int(r)]
    except (ValueError, IndexError):
        return None
    if os.path.isfile(racine):
        return racine if p == "" else None
    base = os.path.realpath(racine)
    chemin = os.path.realpath(os.path.join(base, p))
    if os.path.commonpath([chemin, base]) != base or not os.path.isfile(chemin):
        return None
    return chemin


