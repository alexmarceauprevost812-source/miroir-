# ---------- générateur de QR : wifi, contact, lien, texte ----------

def echapper_wifi(texte):
    return "".join("\\" + c if c in '\\;,:"' else c for c in texte)


def qr_wifi(ssid, mdp, securite="WPA", cache=False):
    securite = {"aucune": "nopass", "": "nopass", "nopass": "nopass"}.get(securite, securite)
    texte = f"WIFI:T:{securite};S:{echapper_wifi(ssid)};"
    if securite != "nopass":
        texte += f"P:{echapper_wifi(mdp)};"
    if cache:
        texte += "H:true;"
    return texte + ";"


def wifi_actuel():
    """(ssid, mot de passe, sécurité) du Wi-Fi actuel via NetworkManager, ou None."""
    if not shutil.which("nmcli"):
        return None
    lignes = executer(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"],
                      sortie=True).decode(errors="replace").splitlines()
    for ligne in lignes:
        nom, _, type_ = ligne.rpartition(":")
        if type_ != "802-11-wireless":
            continue
        nom = nom.replace("\\:", ":")

        def champ(c):
            return executer(["nmcli", "-s", "-g", c, "connection", "show", nom],
                            sortie=True).decode(errors="replace").strip()
        ssid = champ("802-11-wireless.ssid") or nom
        gestion = champ("802-11-wireless-security.key-mgmt")
        if gestion == "none":
            return ssid, champ("802-11-wireless-security.wep-key0"), "WEP"
        if gestion == "sae":
            return ssid, champ("802-11-wireless-security.psk"), "SAE"
        if gestion in ("wpa-psk", "wpa-none"):
            return ssid, champ("802-11-wireless-security.psk"), "WPA"
        return ssid, "", "nopass"
    return None


def cmd_wifi(args):
    if args.ssid:
        ssid, securite = args.ssid, args.securite
        mdp = args.mdp
        if mdp is None and securite != "aucune":
            mdp = getpass.getpass(f"Mot de passe du Wi-Fi « {ssid} » : ")
    else:
        trouve = wifi_actuel()
        if not trouve:
            sys.exit("miroir: Wi-Fi actuel introuvable (NetworkManager). "
                     "Précisez-le : miroir wifi --ssid NOM [--mdp MOTDEPASSE]")
        ssid, mdp, securite = trouve
        if securite != "nopass" and not mdp:
            mdp = getpass.getpass(f"Mot de passe du Wi-Fi « {ssid} » (non lisible automatiquement) : ")
    donnees = qr_wifi(ssid, mdp or "", securite, args.cache)
    sortir_qr(donnees, args.sortie, f"Wi-Fi « {ssid} » : l'invité scanne avec l'appareil photo pour se connecter.")


def echapper_vcard(texte):
    return texte.replace("\\", "\\\\").replace(",", "\\,").replace(";", "\\;").replace("\n", "\\n")


def vcard(a):
    morceaux = a.nom.strip().split()
    prenom, nom = (" ".join(morceaux[:-1]), morceaux[-1]) if len(morceaux) > 1 else ("", a.nom.strip())
    lignes = ["BEGIN:VCARD", "VERSION:3.0",
              f"N:{echapper_vcard(nom)};{echapper_vcard(prenom)};;;", f"FN:{echapper_vcard(a.nom.strip())}"]
    for tel in a.tel or []:
        lignes.append(f"TEL;TYPE=CELL:{echapper_vcard(tel)}")
    for courriel in a.email or []:
        lignes.append(f"EMAIL:{echapper_vcard(courriel)}")
    if a.org:
        lignes.append(f"ORG:{echapper_vcard(a.org)}")
    if a.poste:
        lignes.append(f"TITLE:{echapper_vcard(a.poste)}")
    if a.adresse:
        lignes.append(f"ADR:;;{echapper_vcard(a.adresse)};;;;")
    if a.site:
        lignes.append(f"URL:{echapper_vcard(a.site)}")
    lignes.append("END:VCARD")
    return "\r\n".join(lignes)


def sortir_qr(donnees, sortie, legende):
    if sortie:
        qr_fichier(donnees, sortie)
        print(f"Code QR enregistré : {sortie}")
    else:
        print()
        qr_terminal(donnees)
    print(f"\n  {legende}\n")


def cmd_qr(args):
    if args.type == "lien":
        lien = args.valeur
        if "://" not in lien:
            lien = "https://" + lien
        sortir_qr(lien, args.sortie, f"Lien : {lien}")
    elif args.type == "texte":
        texte = " ".join(args.valeur) if args.valeur else sys.stdin.read()
        sortir_qr(texte, args.sortie, f"Texte ({len(texte)} caractères)")
    elif args.type == "contact":
        sortir_qr(vcard(args), args.sortie, f"Carte de contact : {args.nom}")
    elif args.type == "wifi":
        cmd_wifi(args)


